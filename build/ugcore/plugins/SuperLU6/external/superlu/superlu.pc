prefix=/usr/local
libdir=/usr/local/lib
includedir=/usr/local/include

Name: UG4
Description: Direct solution of large, sparse systems of linear equations
Version: 7.0.1
URL: https://portal.nersc.gov/project/sparse/superlu/

Libs: -L${libdir} -lsuperlu
Libs.private: /Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/System/Library/Frameworks/Accelerate.framework -lm
Cflags: -I${includedir}
